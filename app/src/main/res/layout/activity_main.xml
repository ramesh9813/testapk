<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CustomShield VPN"
        android:textColor="#F8FAFC"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Disconnected"
        android:textColor="#38BDF8"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/serverInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="VPN Endpoint (e.g., vpn.example.com:51820)"
        android:text="10.8.0.1:51820"
        android:textColor="#F8FAFC"
        android:textColorHint="#94A3B8"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/dnsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Secure DNS Server (e.g., 1.1.1.1)"
        android:text="1.1.1.1"
        android:textColor="#F8FAFC"
        android:textColorHint="#94A3B8"
        android:padding="14dp"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/connectBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Connect VPN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF" />

</LinearLayout>
